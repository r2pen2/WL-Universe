# QA stub for nicole-levin — copied to /opt/services/data/app-env/qa/nicole-levin.env on first deploy.
# CMS_COLLECTION_PREFIX is injected by generate-compose for CMS apps (qa-pr-<n>-).
# Do NOT point SITE_MAIL / Stripe at prod. CMS uses prod Firebase project with qa-pr-* collections only.
PORT=3005
SITE_MAIL_URL=
SITE_MAIL_API_KEY=
SITE_MAIL_SITE_SLUG=nicole-levin
REACT_APP_SITE_MAIL_URL=
REACT_APP_SITE_MAIL_API_KEY=
REACT_APP_SITE_MAIL_SITE_SLUG=nicole-levin
