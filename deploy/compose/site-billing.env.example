# Runtime secrets live outside git at /opt/services/data/app-env/site-billing.env
PORT=3021
SITE_BILLING_API_KEY=replace-with-strong-shared-secret
SITE_BILLING_RATE_LIMIT=120
SITE_BILLING_STATE_DIR=/opt/services/data/app-assets/site-billing
SITE_BILLING_CATALOG_PATH=/repo/deploy/billing/sites.json
SITE_BILLING_TRAEFIK_DYNAMIC_PATH=/opt/services/infra/traefik/dynamic/billing-blocks.yml
SITE_BILLING_TRAEFIK_SERVICE_URL=http://site-billing:3021
SITE_BILLING_PORTAL_RETURN_URL=https://billing.joed.dev/health
SITE_BILLING_RECONCILE_MS=3600000
SITE_BILLING_ENFORCE_MS=300000
SITE_BILLING_ALLOW_DEBUG=false

# Stripe (use test keys until go-live)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
