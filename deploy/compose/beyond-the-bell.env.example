# Application secrets live outside git.
# Runtime file: /opt/services/data/app-env/beyond-the-bell.env

# site-mail microservice (shared key with /opt/services/data/app-env/site-mail.env)
SITE_MAIL_URL=https://site-mail.joed.dev
SITE_MAIL_API_KEY=
SITE_MAIL_SITE_SLUG=beyond-the-bell
REACT_APP_SITE_MAIL_URL=https://site-mail.joed.dev
REACT_APP_SITE_MAIL_API_KEY=
REACT_APP_SITE_MAIL_SITE_SLUG=beyond-the-bell

# wl-cms microservice
WL_CMS_URL=https://wl-cms.joed.dev
WL_CMS_API_KEY=
WL_CMS_SITE=beyond-the-bell
REACT_APP_WL_CMS_URL=https://wl-cms.joed.dev
REACT_APP_WL_CMS_API_KEY=
REACT_APP_WL_CMS_SITE=beyond-the-bell

# wl-auth / wl-forms
WL_AUTH_URL=https://wl-auth.joed.dev
WL_AUTH_API_KEY=
WL_AUTH_SITE=beyond-the-bell
WL_FORMS_URL=https://wl-forms.joed.dev
WL_FORMS_API_KEY=
WL_FORMS_SITE=beyond-the-bell

# Optional Express shell-hit beacons (default off). Client SPA tracking uses
# website IDs from packages/web-legos/api/umamiRegistry.ts (baked at image build).
# UMAMI_SERVER_TRACKING=1
# UMAMI_URL=https://analytics.joed.dev
# UMAMI_WEBSITE_ID=
# Default: no tracking on *.qa.joed.dev even when enabled.
