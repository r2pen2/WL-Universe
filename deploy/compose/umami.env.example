# Copy to /opt/services/data/app-env/umami.env on glados (never commit real values).
#
# Generate:
#   openssl rand -hex 24          # POSTGRES_PASSWORD
#   openssl rand -base64 32       # APP_SECRET
#   openssl rand -base64 24       # UMAMI_ADMIN_PASSWORD (after first login change)

POSTGRES_PASSWORD=replace-me-strong-db-password
APP_SECRET=replace-me-with-openssl-rand-base64-32

# Used only by scripts/analytics/provision-websites.mjs (not by compose).
# Default Umami bootstrap user is admin / umami — change immediately after first boot.
UMAMI_ADMIN_USER=admin
UMAMI_ADMIN_PASSWORD=replace-me-strong-admin-password
