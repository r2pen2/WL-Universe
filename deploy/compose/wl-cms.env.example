# wl-cms production / glados env
PORT=3021
WL_CMS_API_KEY=
# Read-only key(s), comma-separated: GET/HEAD only, writes get 403. Generated by
# scripts/glados/provision-cms-read-key.sh for the component catalog (storybook.joed.dev).
WL_CMS_READ_API_KEY=
WL_CMS_ASSETS_DIR=/opt/services/data/app-assets/wl-cms

# Optional QA Firestore prefix
# CMS_COLLECTION_PREFIX=

# Per-site service account paths inside the container
# WL_CMS_SA_NICOLE_LEVIN=/sa/nicole-levin/serviceAccountKey.json
# WL_CMS_SA_BEYOND_THE_BELL=/sa/beyond-the-bell/serviceAccountKey.json
# WL_CMS_SA_TALK_ABOUT_DREAMS=/sa/talk-about-dreams/serviceAccountKey.json
# WL_CMS_SA_BOSTON_MIXTAPE=/sa/boston-mixtape/serviceAccountKey.json
# WL_CMS_SA_A_NEW_DAY_COACHING=/sa/a-new-day-coaching/serviceAccountKey.json
# WL_CMS_SA_YOU_CAN_DO_IT_GARDENING=/sa/you-can-do-it-gardening/serviceAccountKey.json
# WL_CMS_SA_ROOM01890=/sa/room01890/serviceAccountKey.json  (wladminportal project, siteKey R01)
