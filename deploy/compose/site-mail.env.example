# Runtime secrets live outside git at /opt/services/data/app-env/site-mail.env
PORT=3020
SITE_MAIL_API_KEY=replace-with-strong-shared-secret
SITE_MAIL_RATE_LIMIT=60
SITE_MAIL_LOG_DIR=/opt/services/data/app-assets/site-mail

