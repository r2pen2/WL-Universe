# Local microservice stack for CRA clients (`npm run stack`)
# Copy to deploy/local/.env and fill in values.

# Required
WL_CMS_API_KEY=dev-cms-key-change-me
WL_CMS_URL=http://localhost:3021
WL_AUTH_API_KEY=dev-auth-key-change-me
WL_AUTH_URL=http://localhost:3022

# Optional (started when set, or `npm run stack -- --forms` / `--mail`)
WL_FORMS_API_KEY=
WL_FORMS_URL=http://localhost:3023
SITE_MAIL_API_KEY=
SITE_MAIL_URL=http://localhost:3020

# Per-site auth user keys (needed for admin list-all-users)
# NLUSERKEY=
# BTBUSERKEY=
# TAGUSERKEY=
# BBMUSERKEY=
# ANDCUSERKEY=
# YCDUSERKEY=

# Per-site form keys
# BTBFORMKEY=
# BBMFORMKEY=
# ANDCFORMKEY=

# Optional QA isolation prefix for Firestore collections
# CMS_COLLECTION_PREFIX=

# Optional SA path overrides (default: packages/<slug>/config/serviceAccountKey.json)
# WL_CMS_SA_NICOLE_LEVIN=
# WL_AUTH_SA_NICOLE_LEVIN=
